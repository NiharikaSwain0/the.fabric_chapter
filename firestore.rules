rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validAddress(address) {
      return address is map
        && address.keys().hasOnly([
          'fullName', 'email', 'phone', 'house', 'street', 'area',
          'city', 'state', 'pinCode'
        ])
        && address.keys().hasAll([
          'fullName', 'email', 'phone', 'house', 'street', 'area',
          'city', 'state', 'pinCode'
        ])
        && address.fullName is string
        && address.fullName.size() > 0
        && address.fullName.size() <= 80
        && address.email is string
        && address.email.size() <= 254
        && address.phone is string
        && address.phone.matches('^[+]?[0-9][0-9 ()-]{8,18}$')
        && address.house is string
        && address.house.size() > 0
        && address.house.size() <= 180
        && address.street is string
        && address.street.size() > 0
        && address.street.size() <= 180
        && address.area is string
        && address.area.size() > 0
        && address.area.size() <= 180
        && address.city is string
        && address.city.size() > 0
        && address.city.size() <= 100
        && address.state is string
        && address.state.size() > 0
        && address.state.size() <= 100
        && address.pinCode is string
        && address.pinCode.matches('^[0-9]{6}$');
    }

    function validGift(gift) {
      return gift is map
        && gift.keys().hasOnly([
          'recipientName', 'recipientPhone', 'senderName', 'giftMessage'
        ])
        && gift.keys().hasAll([
          'recipientName', 'recipientPhone', 'senderName', 'giftMessage'
        ])
        && gift.recipientName is string
        && gift.recipientName.size() > 0
        && gift.recipientName.size() <= 100
        && gift.recipientPhone is string
        && gift.recipientPhone.matches('^[0-9]{10,13}$')
        && gift.senderName is string
        && gift.senderName.size() > 0
        && gift.senderName.size() <= 80
        && gift.giftMessage is string
        && gift.giftMessage.size() <= 300;
    }

    function validOrderCreate(orderId) {
      return request.resource.data.keys().hasOnly([
          'orderId', 'userId', 'items', 'address', 'gift',
          'paymentMethod', 'subtotal', 'shipping', 'total',
          'orderStatus', 'paymentStatus', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'orderId', 'userId', 'items', 'address', 'paymentMethod',
          'subtotal', 'shipping', 'total', 'orderStatus',
          'paymentStatus', 'createdAt'
        ])
        && request.resource.data.orderId == orderId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.orderStatus == 'Order Placed'
        && request.resource.data.paymentMethod in ['COD', 'UPI']
        && ((request.resource.data.paymentMethod == 'COD'
              && request.resource.data.paymentStatus == 'Pending')
          || (request.resource.data.paymentMethod == 'UPI'
              && request.resource.data.paymentStatus == 'Verification Pending'))
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && validAddress(request.resource.data.address)
        && (!('gift' in request.resource.data)
          || validGift(request.resource.data.gift))
        && request.resource.data.subtotal is number
        && request.resource.data.subtotal >= 0
        && request.resource.data.shipping is number
        && request.resource.data.shipping >= 0
        && request.resource.data.total is number
        && request.resource.data.total == request.resource.data.subtotal + request.resource.data.shipping
        && request.resource.data.createdAt == request.time;
    }

    match /admins/{uid} {
      allow get: if owns(uid) || isAdmin();
      allow list, create, update, delete: if false;
    }

    match /products/{productId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /hampers/{hamperId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /hamperItems/{itemId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if owns(uid);
      allow create: if owns(uid)
        && request.resource.data.keys().hasOnly([
          'displayName', 'email', 'phone', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80;
      allow update: if owns(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'email', 'phone', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'displayName', 'email', 'phone', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80;
      allow delete: if false;
    }

    match /carts/{uid} {
      allow read, create, update, delete: if owns(uid);
    }

    match /wishlists/{uid} {
      allow read, create, update, delete: if owns(uid);
    }

    match /addresses/{addressId} {
      allow read, delete: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }

    match /orders/{orderId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.auth.token.email_verified == true
        && validOrderCreate(orderId);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'orderStatus', 'paymentStatus', 'updatedAt'
        ])
        && request.resource.data.orderStatus in [
          'Order Placed', 'Confirmed', 'Processing', 'Shipped',
          'Out for Delivery', 'Delivered', 'Cancelled'
        ]
        && request.resource.data.paymentStatus in [
          'Pending', 'Verification Pending', 'Paid', 'Failed', 'Refunded'
        ]
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /paymentReferences/{orderId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'orderId', 'userId', 'reference', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'orderId', 'userId', 'reference', 'status', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.orderId == orderId
        && request.resource.data.reference is string
        && request.resource.data.reference.size() >= 6
        && request.resource.data.reference.size() <= 80
        && request.resource.data.status == 'submitted'
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid
        && get(/databases/$(database)/documents/orders/$(orderId)).data.paymentMethod == 'UPI'
        && get(/databases/$(database)/documents/orders/$(orderId)).data.paymentStatus == 'Verification Pending';
      allow update, delete: if false;
    }

    match /coupons/{couponId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    match /inventory/{inventoryId} {
      allow read, write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if settingId in ['hamperBuilder', 'upiId', 'storefront']
        || isAdmin();
      allow write: if isAdmin();
    }
  }
}
